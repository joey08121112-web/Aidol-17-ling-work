# Copy to .env. All keys stay on the backend; empty keys enable offline demo.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/aidol.sqlite3
# Optional shared password for any deployment beyond localhost.
APP_TOKEN=
DOUBAO_API_KEY=
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
DOUBAO_MODEL=1.2.6.1
DOUBAO_VOICE=zh_female_vv_jupiter_bigtts
# Defaults match the attached competition MaaS demo, NOT DashScope credentials.
QWEN_API_KEY=
QWEN_REALTIME_URL=wss://maas.qianwenaiapi.com/api-ws/v1/realtime
QWEN_MODEL=qwen3.8-omni-flash-realtime
QWEN_VOICE=Tina
# Optional OpenAI-compatible text endpoint for asynchronous memory extraction.
TEXT_API_KEY=
TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEXT_MODEL=doubao-seed-2-1-turbo-260628
AMAP_API_KEY=
# Explicit proxy if required by your network. Leave blank normally.
UPSTREAM_PROXY=
# Independent speech services. These credentials do NOT imply realtime duplex access.
SPEECH_VOLC_APP_KEY=
SPEECH_VOLC_ACCESS_KEY=
SPEECH_VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
SPEECH_VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# stream: continuous ASR 2.0; flash: VAD-segmented HTTP fallback.
SPEECH_ASR_MODE=stream
TTS_VOLC_APP_KEY=
TTS_VOLC_ACCESS_KEY=
TTS_VOLC_RESOURCE_ID=seed-tts-1.0
TTS_VOLC_VOICE_TYPE=zh_female_jitangmeimei_mars_bigtts
TTS_VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
PROVIDER_PROXY=
# Hosted Android mode (legacy local web remains the default).
AIDOL_HOSTED=false
AIDOL_DATA_DIR=data/hosted
AIDOL_REGISTRATION_OPEN=true
AIDOL_MAX_USERS=500
# Counts provider operations, including TTS/maps, not complete voice conversations.
AIDOL_DAILY_REQUESTS=300
