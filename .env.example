# Copy to .env. All provider keys stay on the backend, never in the APK or website.
# Empty keys allow account/text fallback tests; real ASR/TTS requires credentials.
HOST=127.0.0.1
PORT=8108
# run.py only: comma-separated trusted reverse-proxy IPs/networks. Empty disables
# forwarded headers. Set exact proxy addresses when placing Docker behind nginx.
FORWARDED_ALLOW_IPS=
# OpenAI-compatible text endpoint for conversation, memory and meeting summaries.
TEXT_API_KEY=
TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEXT_MODEL=doubao-seed-2-1-turbo-260628
AMAP_API_KEY=
BOCHA_API_KEY=
# Explicit proxy if required by your network. Leave blank normally.
UPSTREAM_PROXY=
# Native Qwen Omni audio-in/audio-out for explicit Android AI calls. A configured
# key enables capabilities.voice_realtime; updated Android clients prefer it.
# Defaults match qwen_omni_demo1111.zip's MaaS endpoint. Never put this key in APKs.
QWEN_OMNI_API_KEY=
QWEN_OMNI_WS_URL=wss://maas.qianwenaiapi.com/api-ws/v1/realtime
QWEN_OMNI_MODEL=qwen3.8-omni-flash-realtime
QWEN_OMNI_VOICE=Tina
QWEN_OMNI_TRANSCRIPTION_MODEL=qwen3-asr-flash-realtime
QWEN_OMNI_OUTPUT_FORMAT=pcm24
# Cloud speech probability threshold, not PCM volume; higher is less sensitive.
QWEN_OMNI_ASR_VAD_THRESHOLD=0.65
# New work meetings use qwen-audio-3.1-asr-flash-filetrans with whole-meeting diarization.
# This legacy Flash URL also supplies the origin for Filetrans /api/v1 endpoints.
# Defaults to the existing Qianwen service; reuses QWEN_OMNI_API_KEY only on that same host.
# Set a dedicated key for overrides; credentials are never inherited across providers.
QWEN_WORK_ASR_API_KEY=
QWEN_WORK_ASR_URL=https://maas.qianwenaiapi.com/api/v1/services/aigc/multimodal-generation/generation
# Android voice: ASR 2.0 -> text model -> TTS.
SPEECH_VOLC_APP_KEY=
SPEECH_VOLC_ACCESS_KEY=
SPEECH_VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
SPEECH_VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# Provider diagnostic script only. The Android account API always uses streaming ASR.
# stream: ASR 2.0; flash: separate HTTP service (requires its own entitlement).
SPEECH_ASR_MODE=stream
TTS_VOLC_APP_KEY=
TTS_VOLC_ACCESS_KEY=
TTS_VOLC_RESOURCE_ID=seed-tts-1.0
TTS_VOLC_VOICE_TYPE=zh_female_jitangmeimei_mars_bigtts
TTS_VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
PROVIDER_PROXY=
# Account API data for run.py/Docker/hosted deployments.
# start-android-backend.* always uses isolated data/android-local/ and port 8108.
AIDOL_DATA_DIR=data/hosted
AIDOL_REGISTRATION_OPEN=true
AIDOL_MAX_USERS=500
# Counts provider operations, including TTS/maps, not complete voice conversations.
AIDOL_DAILY_REQUESTS=300
